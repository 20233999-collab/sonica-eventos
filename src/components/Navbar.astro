---
// Navbar.astro - Floating capsule navbar with glassmorphism & beam-glow button
---

<!-- Dynamic progressive blur behind navbar when scrolled past hero -->
<div
  id="navbar-top-blur"
  class="fixed top-0 inset-x-0 h-24 pointer-events-none z-40 bg-gradient-to-b from-[#090D16]/90 via-[#090D16]/40 to-transparent backdrop-blur-md opacity-0 transition-opacity duration-500 [mask-image:linear-gradient(to_bottom,black_40%,transparent_100%)]"
></div>

<header
  id="main-navbar"
  class="fixed top-5 inset-x-0 z-50 px-4 sm:px-6 pointer-events-none -translate-y-28 opacity-0 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]"
>
  <div class="max-w-6xl mx-auto flex items-center justify-between pointer-events-auto bg-[#0E1626]/85 backdrop-blur-xl border border-white/10 rounded-full px-5 py-3 shadow-beautiful-md">
    <!-- Brand Logo -->
    <a href="#" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-cyan rounded-full p-1">
      <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-brand-cyan to-brand-blue flex items-center justify-center shadow-glow-cyan">
        <svg class="w-5 h-5 text-white transform group-hover:scale-110 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 10v3" />
          <path d="M6 6v11" />
          <path d="M10 3v18" />
          <path d="M14 8v7" />
          <path d="M18 5v13" />
          <path d="M22 10v4" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-display font-extrabold tracking-tight text-lg text-white group-hover:text-brand-light transition-colors leading-none">
          SÓNICA<span class="text-brand-cyan">.</span>
        </span>
        <span class="font-mono text-[10px] tracking-widest text-slate-400 uppercase -mt-0.5">PERÚ</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-300">
      <a href="#experiencias" class="hover:text-white hover:text-shadow transition-colors">Experiencias</a>
      <a href="#servicios" class="hover:text-white transition-colors">Servicios 360°</a>
      <a href="#casos" class="hover:text-white transition-colors">Casos Reales</a>
      <a href="#cultura" class="hover:text-white transition-colors">Backstage</a>
    </nav>

    <!-- CTAs & Direct Contact -->
    <div class="flex items-center gap-3">
      <!-- WhatsApp Quick Icon (Hidden on very small screens) -->
      <a
        href="https://wa.me/51948435104?text=Hola%20S%C3%B3nica%20Per%C3%BA%2C%20quisiera%20cotizar%20un%20evento%20corporativo%20o%20activaci%C3%B3n"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Contactar por WhatsApp"
        class="hidden sm:flex items-center justify-center w-9 h-9 rounded-full bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/20 transition-all hover:scale-105"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
      </a>

      <!-- Primary Action CTA -->
      <a
        href="#contacto"
        class="beam-glow-btn inline-flex items-center gap-2 bg-gradient-to-r from-brand-cyan to-brand-blue hover:from-brand-light hover:to-brand-cyan text-white text-xs sm:text-sm font-semibold px-4 sm:px-5 py-2 sm:py-2.5 rounded-full shadow-glow-cyan transition-all transform hover:scale-[1.02] active:scale-[0.98]"
      >
        <span>Agendar Sesión</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initNavbarVisibility() {
    const navbar = document.getElementById('main-navbar');
    const topBlur = document.getElementById('navbar-top-blur');
    const hero = document.getElementById('experiencias');

    if (!navbar || !hero) return;

    const showNavbar = () => {
      navbar.classList.remove('-translate-y-28', 'opacity-0');
      navbar.classList.add('translate-y-0', 'opacity-100');
      topBlur?.classList.remove('opacity-0');
      topBlur?.classList.add('opacity-100');
    };

    const hideNavbar = () => {
      navbar.classList.remove('translate-y-0', 'opacity-100');
      navbar.classList.add('-translate-y-28', 'opacity-0');
      topBlur?.classList.remove('opacity-100');
      topBlur?.classList.add('opacity-0');
    };

    // Trigger visibility as the user scrolls past the hero section
    ScrollTrigger.create({
      trigger: hero,
      start: 'bottom 120px',
      onEnter: showNavbar,
      onLeaveBack: hideNavbar,
    });

    // Check initial position on load / reload
    const checkScroll = () => {
      const heroRect = hero.getBoundingClientRect();
      if (heroRect.bottom <= 120) {
        showNavbar();
      } else {
        hideNavbar();
      }
    };

    checkScroll();
    window.addEventListener('scroll', checkScroll, { passive: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavbarVisibility);
  } else {
    initNavbarVisibility();
  }
</script>
