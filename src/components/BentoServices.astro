        <a href="#contacto" class="relative z-10 pt-3.5 mt-3 border-t border-white/5 flex items-center justify-between text-xs font-mono group/link">
          <span class="text-slate-400 text-[11px]">RIMAC, Breca</span>
          <span class="text-emerald-400 flex items-center gap-1 group-hover/link:translate-x-1 transition-transform">
            <span>Cotizar</span>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      </div>

      <!-- CARD 06: Inteligencia & CX (Telemetry Sparkline Tracker) -->
      <div class="gradient-border-card md:col-span-1 lg:col-span-1 p-5 sm:p-6 flex flex-col justify-between group overflow-hidden relative shadow-beautiful-md">
        <!-- Unique Style: Live Telemetry Sparkline on top right -->
        <div class="relative z-10">
          <div class="flex items-center justify-between mb-3.5">
            <div class="flex items-center gap-2">
              <span class="w-9 h-9 rounded-lg bg-brand-cyan/10 border border-brand-cyan/25 flex items-center justify-center text-brand-cyan group-hover:scale-110 transition-transform duration-300">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="12" y1="16" x2="12" y2="12" />
                  <line x1="12" y1="8" x2="12.01" y2="8" />
                </svg>
              </span>
              <span class="font-mono text-[10px] text-brand-cyan bg-brand-cyan/10 border border-brand-cyan/20 px-2 py-0.5 rounded">
                [ ROI TRACKER ]
              </span>
            </div>

            <!-- Animated Mini Sparkline Bar Chart -->
            <div class="flex items-center gap-2">
              <div class="flex items-end gap-1 h-3.5 px-1.5 py-0.5 rounded bg-white/5 border border-white/10 group-hover:border-brand-cyan/30 transition-colors">
                <div class="w-1 bg-slate-500 group-hover:bg-brand-cyan h-1.5 group-hover:h-2.5 rounded-xs transition-all duration-300"></div>
                <div class="w-1 bg-slate-500 group-hover:bg-brand-cyan h-2 group-hover:h-3 rounded-xs transition-all duration-300 delay-75"></div>
                <div class="w-1 bg-brand-cyan h-2.5 group-hover:h-3.5 rounded-xs transition-all duration-300 delay-150"></div>
              </div>
              <span class="font-mono text-xs text-slate-500">06 / 06</span>
            </div>
          </div>

          <h3 class="font-display font-bold text-lg text-white mb-1.5 group-hover:text-brand-cyan transition-colors">
            Inteligencia & CX
