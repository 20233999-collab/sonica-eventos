              <div class="flex items-end gap-0.5 h-3">
                <span class="w-0.5 h-1.5 bg-brand-cyan rounded-full transition-all duration-300 group-hover:h-3"></span>
                <span class="w-0.5 h-3 bg-brand-cyan rounded-full transition-all duration-300 group-hover:h-1.5"></span>
                <span class="w-0.5 h-2 bg-brand-cyan rounded-full transition-all duration-300 group-hover:h-3.5"></span>
                <span class="w-0.5 h-2.5 bg-brand-cyan rounded-full transition-all duration-300 group-hover:h-2"></span>
              </div>
              <span class="font-mono text-xs text-slate-500">04 / 06</span>
            </div>
          </div>

          <h3 class="font-display font-bold text-lg text-white mb-1.5 group-hover:text-brand-cyan transition-colors">
            Producción Audiovisual
          </h3>
          <p class="font-body text-slate-400 text-xs sm:text-sm leading-relaxed">
            Cámaras de cine, drones y postproducción express de reels en menos de 24h para amplificar el evento en redes.
          </p>
        </div>

        <a href="#contacto" class="relative z-10 pt-3.5 mt-3 border-t border-white/5 flex items-center justify-between text-xs font-mono group/link">
          <span class="text-slate-400 text-[11px]">4K HDR • Cobertura</span>
          <span class="text-brand-cyan flex items-center gap-1 group-hover/link:translate-x-1 transition-transform">
            <span>Cotizar</span>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      </div>

      <!-- CARD 05: Endomarketing & People (Synergy Pulse & Engagement Aura) -->
      <div class="gradient-border-card md:col-span-1 lg:col-span-1 p-5 sm:p-6 flex flex-col justify-between group overflow-hidden relative shadow-beautiful-md">
        <!-- Unique Style: Synergy Pulse Aura expanding on hover -->
        <div class="absolute -top-6 -right-6 w-24 h-24 bg-gradient-to-br from-emerald-500/15 to-brand-cyan/15 rounded-full blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

        <div class="relative z-10">
          <div class="flex items-center justify-between mb-3.5">
            <div class="flex items-center gap-2">
              <span class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/25 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
              </span>
              <span class="inline-flex items-center gap-1 font-mono text-[10px] text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                98% NPS
              </span>
            </div>
            <span class="font-mono text-xs text-slate-500">05 / 06</span>
          </div>

          <h3 class="font-display font-bold text-lg text-white mb-1.5 group-hover:text-emerald-300 transition-colors">
            Endomarketing & People
          </h3>
          <p class="font-body text-slate-400 text-xs sm:text-sm leading-relaxed">
            Team building vivencial, torneos deportivos SNI y celebraciones que multiplican el orgullo de pertenencia.
          </p>
