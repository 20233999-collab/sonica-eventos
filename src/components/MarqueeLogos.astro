---
// MarqueeLogos.astro - Acto 2: Validación Instantánea (marquee-loop skill)

const clients = [
  { name: "BBVA", category: "Banca & Finanzas" },
  { name: "MEGALABS", category: "Farmacéutica Internacional" },
  { name: "RIMAC SEGUROS", category: "Seguros & Salud" },
  { name: "GRUPO BRECA", category: "Conglomerado Corporativo" },
  { name: "NATURA & CO", category: "Belleza & Cosmética" },
  { name: "URBANA PERÚ", category: "Desarrollo Inmobiliario" },
  { name: "PETROPERÚ", category: "Energía & Petróleo" },
  { name: "CONMEBOL", category: "Deportes & Eventos VIP" },
  { name: "SGS", category: "Certificación & Minería" },
  { name: "MERCADO PAGO", category: "Fintech & E-commerce" },
  { name: "ESSALUD", category: "Sector Salud" },
  { name: "PROMPERÚ", category: "Marca País" },
  { name: "CLÍNICA INTERNACIONAL", category: "Red Hospitalaria" },
  { name: "LÍNEA 1 METRO", category: "Infraestructura & Transporte" },
];
---

<section class="relative py-12 bg-[#090D16] border-y border-white/5 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 mb-6 text-center">
    <p class="font-mono text-xs uppercase tracking-widest text-slate-400 font-medium">
      Marcas líderes que confían en la producción de Sónica Perú
    </p>
  </div>

  <!-- Marquee Container with Left & Right Alpha Masks (css-alpha-masking / marquee-loop skill) -->
  <div class="relative w-full overflow-hidden flex items-center">
    <!-- Left Fade Gradient -->
    <div class="absolute left-0 top-0 bottom-0 w-24 sm:w-40 z-10 bg-gradient-to-r from-canvas via-canvas/90 to-transparent pointer-events-none"></div>
    
    <!-- Right Fade Gradient -->
    <div class="absolute right-0 top-0 bottom-0 w-24 sm:w-40 z-10 bg-gradient-to-l from-canvas via-canvas/90 to-transparent pointer-events-none"></div>

    <!-- Scrolling Track (Double list for seamless 50% loop) -->
    <div class="animate-marquee flex items-center gap-6 sm:gap-10 py-3">
      {/* Set 1 */}
      {clients.map((client) => (
        <div class="flex items-center gap-3 px-6 py-3 rounded-xl bg-surface/40 border border-white/5 backdrop-blur-sm transition-all duration-300 hover:border-brand-cyan/40 hover:bg-surface/80 group shrink-0 cursor-default">
          <div class="w-2 h-2 rounded-full bg-brand-cyan/40 group-hover:bg-brand-cyan transition-colors"></div>
          <div class="flex flex-col">
            <span class="font-display font-bold text-sm sm:text-base tracking-wider text-slate-300 group-hover:text-white transition-colors">
              {client.name}
            </span>
            <span class="font-mono text-[9px] text-slate-400 uppercase tracking-widest group-hover:text-brand-cyan/80 transition-colors">
              {client.category}
            </span>
          </div>
        </div>
      ))}

      {/* Set 2 (Identical Duplicate for Infinite Loop) */}
      {clients.map((client) => (
        <div class="flex items-center gap-3 px-6 py-3 rounded-xl bg-surface/40 border border-white/5 backdrop-blur-sm transition-all duration-300 hover:border-brand-cyan/40 hover:bg-surface/80 group shrink-0 cursor-default" aria-hidden="true">
          <div class="w-2 h-2 rounded-full bg-brand-cyan/40 group-hover:bg-brand-cyan transition-colors"></div>
          <div class="flex flex-col">
            <span class="font-display font-bold text-sm sm:text-base tracking-wider text-slate-300 group-hover:text-white transition-colors">
              {client.name}
            </span>
            <span class="font-mono text-[9px] text-slate-400 uppercase tracking-widest group-hover:text-brand-cyan/80 transition-colors">
              {client.category}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
