  <!-- Wizard State Machine & GSAP Choreography Script -->
  <script>
    import { gsap } from 'gsap';

    // Wizard Data Store
    const formData: Record<string, any> = {
      tipo_evento: '',
      sector: '',
      aforo: '',
      tiempo: '',
      presupuesto: '',
      servicios: [] as string[],
      descripcion: '',
      nombre: '',
      empresa: '',
      cargo: '',
      email: '',
      telefono: ''
    };

    let currentStep = 1;
    const totalSteps = 10;

    // DOM Elements
    const progressBarFill = document.getElementById('progress-bar-fill') as HTMLElement;
    const pageCounterText = document.getElementById('page-counter-text') as HTMLElement;
    const headerPhaseText = document.getElementById('header-phase-text') as HTMLElement;
    const headerPercentText = document.getElementById('header-percent-text') as HTMLElement;
    const btnPrev = document.getElementById('btn-step-prev') as HTMLButtonElement;
    const bottomBar = document.getElementById('wizard-bottom-bar') as HTMLElement;

    // Step Sections
    const steps: HTMLElement[] = [];
    for (let i = 1; i <= totalSteps; i++) {
      const el = document.getElementById(`step-${i}`);
      if (el) steps.push(el);
    }
    const stepSuccess = document.getElementById('step-success') as HTMLElement;

    // Prefill from URL query params
    const urlParams = new URLSearchParams(window.location.search);
    const prefillServicio = urlParams.get('servicio');
    if (prefillServicio) {
      if (prefillServicio.toLowerCase().includes('btl')) {
        formData.tipo_evento = 'Activación BTL o Stand Ferial';
      } else if (prefillServicio.toLowerCase().includes('audiovisual')) {
        formData.tipo_evento = 'Producción Audiovisual & Spots';
      } else if (prefillServicio.toLowerCase().includes('gala') || prefillServicio.toLowerCase().includes('fiesta')) {
        formData.tipo_evento = 'Fiesta de Integración / Gala Anual';
      }
    }

    // Function to render a specific step with GSAP physics
    function goToStep(stepNum: number, direction: 'forward' | 'backward' = 'forward') {
      if (stepNum < 1 || stepNum > totalSteps + 1) return;

      const previousStepEl = currentStep <= totalSteps ? steps[currentStep - 1] : stepSuccess;
      currentStep = stepNum;

      if (currentStep <= totalSteps) {
        const nextStepEl = steps[currentStep - 1];

        // Animate out previous step
        if (previousStepEl && previousStepEl !== nextStepEl) {
          gsap.to(previousStepEl, {
            opacity: 0,
            y: direction === 'forward' ? -10 : 10,
            scale: 0.98,
            duration: 0.18,
            ease: 'power2.in',
            onComplete: () => {
              previousStepEl.classList.add('hidden');
              previousStepEl.classList.remove('flex');

              // Animate in next step
              if (nextStepEl) {
                nextStepEl.classList.remove('hidden');
                nextStepEl.classList.add('flex');

                gsap.fromTo(
                  nextStepEl,
                  { opacity: 0, y: direction === 'forward' ? 14 : -14, scale: 0.98 },
                  { opacity: 1, y: 0, scale: 1, duration: 0.28, ease: 'power2.out' }
                );
              }
            }
          });
        } else if (nextStepEl) {
          nextStepEl.classList.remove('hidden');
          nextStepEl.classList.add('flex');
        }

        // Update progress bar with smooth GSAP tween
        const percent = Math.round((currentStep / totalSteps) * 100);
        if (progressBarFill) {
          gsap.to(progressBarFill, { width: `${percent}%`, duration: 0.35, ease: 'power2.out' });
        }

        // Update phase & counters
        if (pageCounterText) {
          pageCounterText.textContent = `Página ${currentStep}`;
        }
        if (headerPercentText) {
          headerPercentText.textContent = `${percent}% Completado`;
        }
        if (headerPhaseText && nextStepEl) {
          const phaseAttr = nextStepEl.getAttribute('data-phase');
          if (phaseAttr) headerPhaseText.textContent = phaseAttr;
        }

        // Prev button visibility
        if (btnPrev) {
          if (currentStep === 1) {
            gsap.to(btnPrev, { opacity: 0, duration: 0.15, onComplete: () => btnPrev.classList.add('pointer-events-none') });
          } else {
            btnPrev.classList.remove('pointer-events-none');
            gsap.to(btnPrev, { opacity: 1, duration: 0.2 });
          }
        }

        // Focus inputs on desktop
        setTimeout(() => {
          const input = nextStepEl?.querySelector('input:not([type="checkbox"]), textarea') as HTMLElement;
          if (input && window.innerWidth > 768) {
            input.focus();
          }
        }, 220);

      } else {
        // Step Success Transition
        if (previousStepEl) {
          gsap.to(previousStepEl, {
            opacity: 0,
            y: -15,
            duration: 0.2,
            onComplete: () => {
              previousStepEl.classList.add('hidden');
              previousStepEl.classList.remove('flex');

              if (stepSuccess) {
                stepSuccess.classList.remove('hidden');
                stepSuccess.classList.add('flex');

                gsap.fromTo(
                  stepSuccess,
                  { opacity: 0, y: 20, scale: 0.95 },
                  { opacity: 1, y: 0, scale: 1, duration: 0.4, ease: 'power3.out' }
                );
              }
            }
          });
        }

        if (progressBarFill) {
          gsap.to(progressBarFill, { width: '100%', duration: 0.3 });
        }
        if (bottomBar) {
          gsap.to(bottomBar, { opacity: 0, duration: 0.2, onComplete: () => bottomBar.classList.add('hidden') });
        }
        if (headerPhaseText) {
          headerPhaseText.textContent = 'Solicitud Completada • Asignación Express';
        }
        if (headerPercentText) {
          headerPercentText.textContent = '100% Completado';
        }

        // Fill recap
        const recapNombreEmpresa = document.getElementById('recap-nombre-empresa');
        const recapTipo = document.getElementById('recap-tipo');
        const recapAforo = document.getElementById('recap-aforo');
        const recapPresupuesto = document.getElementById('recap-presupuesto');

        if (recapNombreEmpresa) {
          recapNombreEmpresa.textContent = `${formData.nombre || 'Cliente'} (${formData.empresa || 'Empresa'})`;
        }
        if (recapTipo) {
          recapTipo.textContent = formData.tipo_evento || 'Experiencia Personalizada';
        }
        if (recapAforo) {
          recapAforo.textContent = formData.aforo || 'Por definir';
        }
        if (recapPresupuesto) {
          recapPresupuesto.textContent = formData.presupuesto || 'Por definir';
        }
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Auto-advance click handlers for single-select buttons
    document.querySelectorAll('.wizard-option-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const button = e.currentTarget as HTMLButtonElement;
        const key = button.getAttribute('data-key');
        const val = button.getAttribute('data-value');

        if (key && val) {
          formData[key] = val;

          // Visual feedback on card
          const parent = button.closest('.wizard-step');
          parent?.querySelectorAll('.wizard-option-btn').forEach((b) => {
            b.classList.remove('border-brand-cyan', 'bg-[#162035]', 'shadow-glow-cyan');
          });
          button.classList.add('border-brand-cyan', 'bg-[#162035]', 'shadow-glow-cyan');

          // Tactile scale effect
          gsap.fromTo(button, { scale: 0.96 }, { scale: 1, duration: 0.2, ease: 'back.out(2)' });

          // Smooth auto advance after 200ms
          setTimeout(() => {
            goToStep(currentStep + 1, 'forward');
          }, 200);
        }
      });
    });

    // Step 6: Multi-select Checkboxes & Live Count
    const serviceCheckboxes = document.querySelectorAll<HTMLInputElement>('.service-checkbox');
    const multiServicesCount = document.getElementById('multi-services-count');
    const btnStep6 = document.getElementById('btn-step-6-continue');

    serviceCheckboxes.forEach((cb) => {
      cb.addEventListener('change', () => {
        const checkedCount = document.querySelectorAll<HTMLInputElement>('.service-checkbox:checked').length;
        if (multiServicesCount) {
          multiServicesCount.textContent = `${checkedCount} ${checkedCount === 1 ? 'servicio seleccionado' : 'servicios seleccionados'}`;
        }
        // Highlight active card
        const card = cb.closest('.multi-check-card');
        if (cb.checked) {
          card?.classList.add('border-brand-cyan', 'bg-[#162035]');
        } else {
          card?.classList.remove('border-brand-cyan', 'bg-[#162035]');
        }
      });
    });

    btnStep6?.addEventListener('click', () => {
      const checkedBoxes = document.querySelectorAll<HTMLInputElement>('.service-checkbox:checked');
      formData.servicios = Array.from(checkedBoxes).map(cb => cb.value);
      goToStep(7, 'forward');
    });

    // Step 7: Description & Quick Suggestion Tags
    const descInput = document.getElementById('input-descripcion') as HTMLTextAreaElement;
    const btnStep7 = document.getElementById('btn-step-7-continue');
    const btnStep7Skip = document.getElementById('btn-step-7-skip');

    document.querySelectorAll('.quick-tag-btn').forEach((tagBtn) => {
      tagBtn.addEventListener('click', (e) => {
        const appendText = (e.currentTarget as HTMLElement).getAttribute('data-append');
        if (appendText && descInput) {
          if (descInput.value.length > 0) {
            descInput.value += ` • ${appendText}`;
          } else {
            descInput.value = appendText;
          }
          descInput.focus();
        }
      });
    });

    btnStep7?.addEventListener('click', () => {
      if (descInput) formData.descripcion = descInput.value.trim();
      goToStep(8, 'forward');
    });

    btnStep7Skip?.addEventListener('click', () => {
      formData.descripcion = '';
      goToStep(8, 'forward');
    });

    // Step 8: Nombre y Empresa with haptic error shake
    const inputNombre = document.getElementById('input-nombre') as HTMLInputElement;
    const inputEmpresa = document.getElementById('input-empresa') as HTMLInputElement;
    const btnStep8 = document.getElementById('btn-step-8-continue');
    const step8Error = document.getElementById('step-8-error');

    btnStep8?.addEventListener('click', () => {
      const nombre = inputNombre?.value.trim();
      const empresa = inputEmpresa?.value.trim();

      if (!nombre || !empresa) {
        if (step8Error) step8Error.classList.remove('hidden');
        // Emil-design-eng haptic shake
        const targetInput = !nombre ? inputNombre : inputEmpresa;
        if (targetInput) {
          gsap.fromTo(targetInput, { x: -6 }, { x: 6, duration: 0.08, repeat: 3, yoyo: true, onComplete: () => gsap.set(targetInput, { x: 0 }) });
          targetInput.focus();
        }
        return;
      }

      if (step8Error) step8Error.classList.add('hidden');
      formData.nombre = nombre;
      formData.empresa = empresa;
      goToStep(9, 'forward');
    });

    // Step 10: Final Submit with Validation & Loading State
    const inputEmail = document.getElementById('input-email') as HTMLInputElement;
    const inputTelefono = document.getElementById('input-telefono') as HTMLInputElement;
    const btnFinalSubmit = document.getElementById('btn-final-submit') as HTMLButtonElement;
    const step10Error = document.getElementById('step-10-error');
    const submitBtnText = document.getElementById('submit-btn-text');
    const submitBtnIcon = document.getElementById('submit-btn-icon');
    const submitBtnSpinner = document.getElementById('submit-btn-spinner');

    btnFinalSubmit?.addEventListener('click', () => {
      const email = inputEmail?.value.trim();
      const telefono = inputTelefono?.value.trim();
      const emailValid = email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      const telValid = telefono && telefono.length >= 7;

      if (!emailValid || !telValid) {
        if (step10Error) step10Error.classList.remove('hidden');
        const targetErr = !emailValid ? inputEmail : inputTelefono;
        if (targetErr) {
          gsap.fromTo(targetErr, { x: -6 }, { x: 6, duration: 0.08, repeat: 3, yoyo: true, onComplete: () => gsap.set(targetErr, { x: 0 }) });
          targetErr.focus();
        }
        return;
      }

      if (step10Error) step10Error.classList.add('hidden');
      formData.email = email;
      formData.telefono = telefono;

      // Loading state
      btnFinalSubmit.disabled = true;
      if (submitBtnText) submitBtnText.textContent = 'Asignando Director de Cuentas...';
      if (submitBtnIcon) submitBtnIcon.classList.add('hidden');
      if (submitBtnSpinner) submitBtnSpinner.classList.remove('hidden');

      // Local storage persistence
      try {
        const history = JSON.parse(localStorage.getItem('sonica_cotizaciones') || '[]');
        history.push({ ...formData, timestamp: new Date().toISOString() });
        localStorage.setItem('sonica_cotizaciones', JSON.stringify(history));
      } catch (e) {
        console.warn('LocalStorage not available');
      }

      // Smooth step completion
      setTimeout(() => {
        goToStep(11, 'forward');
      }, 900);
    });

    // Previous Button click
    btnPrev?.addEventListener('click', () => {
      if (currentStep > 1) {
        goToStep(currentStep - 1, 'backward');
      }
    });

    // Keyboard navigation (Enter to advance on inputs, keys A-G on options)
    window.addEventListener('keydown', (e) => {
      if (currentStep > totalSteps) return;

      if (e.key === 'Enter' && !e.shiftKey) {
        if (currentStep === 6) {
          e.preventDefault();
          btnStep6?.click();
        } else if (currentStep === 7) {
          if (document.activeElement !== descInput) {
            e.preventDefault();
            btnStep7?.click();
          }
        } else if (currentStep === 8) {
          e.preventDefault();
          btnStep8?.click();
        } else if (currentStep === 10) {
          e.preventDefault();
          btnFinalSubmit?.click();
        }
      }

      if (e.key === 'Escape' && currentStep > 1) {
        e.preventDefault();
        goToStep(currentStep - 1, 'backward');
      }

      // Quick key selection (A - G)
      const isTyping = ['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '');
      if (!isTyping && ['a', 'b', 'c', 'd', 'e', 'f', 'g'].includes(e.key.toLowerCase())) {
        const activeStep = steps[currentStep - 1];
        if (activeStep) {
          const optionBtns = activeStep.querySelectorAll<HTMLButtonElement>('.wizard-option-btn');
          const indexMap: Record<string, number> = { a: 0, b: 1, c: 2, d: 3, e: 4, f: 5, g: 6 };
          const btnToClick = optionBtns[indexMap[e.key.toLowerCase()]];
          if (btnToClick) {
            e.preventDefault();
            btnToClick.click();
          }
        }
      }
    });

    // Initialize first step
    goToStep(1);
  </script>
</Layout>
