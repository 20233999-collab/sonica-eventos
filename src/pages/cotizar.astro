            Por favor ingresa un correo corporativo válido y tu número de teléfono.
          </div>

          <!-- Final Submit Button -->
          <button
            type="button"
            id="btn-final-submit"
            class="w-full mt-2 inline-flex items-center justify-center gap-3 bg-gradient-to-r from-brand-cyan via-brand-light to-brand-blue hover:from-brand-light hover:to-brand-cyan text-white font-semibold text-base px-8 py-4 rounded-full shadow-glow-cyan transition-all transform hover:-translate-y-0.5 active:translate-y-0 group"
          >
            <span id="submit-btn-text">Finalizar Cotización y Solicitar Propuesta</span>
            <svg id="submit-btn-icon" class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
            <div id="submit-btn-spinner" class="hidden w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
          </button>

          <p class="font-body text-xs text-slate-500 text-center mt-1">
            🔒 Privacidad garantizada. Cero spam. Datos tratados bajo estricta confidencialidad corporativa.
          </p>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- PANTALLA FINAL: Confirmación & Asignación de Agente -->
      <!-- ========================================== -->
      <section id="step-success" class="wizard-step w-full flex-col items-center hidden" data-step="success">
        <div class="max-w-xl w-full text-center flex flex-col items-center">
          
          <!-- Animated Checkmark Badge -->
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-gradient-to-tr from-brand-cyan to-brand-blue flex items-center justify-center shadow-glow-cyan mb-5 animate-bounce-short">
            <svg class="w-8 h-8 sm:w-10 sm:h-10 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          </div>

          <!-- Status Indicator -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-mono text-xs uppercase tracking-widest font-semibold mb-4">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            Solicitud Registrada con Éxito
          </div>

          <!-- Main Success Headline -->
          <h2 class="font-display font-black text-2xl sm:text-4xl text-white tracking-tight uppercase leading-tight mb-3">
            ¡Cotización Recibida!
          </h2>

          <!-- USER REQUESTED HIGHLIGHT: Un agente se encargará de contactarte lo antes posible -->
          <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-b from-[#0E1626] to-[#162035] border border-brand-cyan/40 shadow-beautiful-lg mb-6 text-left w-full">
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-full bg-brand-cyan/20 border border-brand-cyan/40 flex items-center justify-center shrink-0 mt-0.5 text-brand-cyan">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
              </div>
              <div>
                <h3 class="font-display font-bold text-white text-base sm:text-lg leading-snug">
                  Un agente especializado se encargará de contactarte lo antes posible.
                </h3>
                <p class="font-body text-xs sm:text-sm text-slate-300 mt-1 leading-relaxed">
                  Nuestro equipo de cuentas y producción técnica ya tiene tu proyecto en bandeja. Te responderemos en un plazo máximo de <strong class="text-brand-cyan">2 horas hábiles</strong> con una propuesta diseñada a tu medida.
                </p>
              </div>
            </div>
          </div>

          <!-- Summary Recap Box -->
          <div class="w-full bg-[#0E1626]/70 border border-white/10 rounded-2xl p-4 sm:p-5 text-left mb-6 text-xs sm:text-sm space-y-2 font-body">
            <h4 class="font-mono text-xs uppercase tracking-widest text-slate-400 font-semibold mb-2">
              Resumen de la Solicitud
            </h4>
            <div class="flex justify-between border-b border-white/5 pb-1.5">
              <span class="text-slate-400">Cliente / Empresa:</span>
              <span class="text-white font-medium" id="recap-nombre-empresa">-</span>
            </div>
            <div class="flex justify-between border-b border-white/5 pb-1.5">
              <span class="text-slate-400">Tipo de Evento:</span>
              <span class="text-brand-light font-medium" id="recap-tipo">-</span>
            </div>
            <div class="flex justify-between border-b border-white/5 pb-1.5">
              <span class="text-slate-400">Aforo Estimado:</span>
              <span class="text-white font-medium" id="recap-aforo">-</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-400">Rango Presupuestal:</span>
              <span class="text-emerald-400 font-semibold" id="recap-presupuesto">-</span>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center gap-3 w-full justify-center">
            <a
              href="/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-brand-cyan to-brand-blue text-white font-semibold text-sm px-6 py-3.5 rounded-full shadow-glow-cyan transition-all hover:scale-102"
            >
              <span>Volver a la Web Principal</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            </a>

            <a
              href="/PRESENTACION%20SONICA%20PERU.pdf"
              download="PRESENTACION SONICA PERU.pdf"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-surface border border-white/15 text-slate-200 hover:text-white font-medium text-sm px-5 py-3.5 rounded-full hover:bg-surface-elevated transition-all"
            >
              <svg class="w-4 h-4 text-brand-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              <span>Descargar Credencial PDF (Brochure)</span>
            </a>
          </div>

          <p class="font-mono text-[11px] text-slate-500 mt-6">
            ¿Es una urgencia inmediata? Llámanos directamente al <a href="tel:+51948435104" class="text-brand-cyan hover:underline">+51 948 435 104</a>
          </p>
        </div>
      </section>

    </main>

    <!-- UNIVERSAL FOOTER: "← Atrás" Button + "Página X de 10" Counter -->
    <footer id="wizard-bottom-bar" class="w-full relative z-20 border-t border-white/5 bg-canvas/90 backdrop-blur-md py-3.5 sm:py-4 px-4 sm:px-6">
      <div class="max-w-4xl mx-auto flex items-center justify-between">
        
        <!-- Back Button -->
        <button
          type="button"
          id="btn-step-prev"
          class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-slate-400 hover:text-white py-1.5 px-3 rounded-lg hover:bg-white/5 transition-all opacity-0 pointer-events-none"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="m15 18-6-6 6-6" />
          </svg>
          <span>Atrás</span>
        </button>

        <!-- Page Counter: "Página X de 10" -->
        <div class="font-mono text-xs sm:text-sm font-semibold text-slate-400 tracking-wider">
          <span id="page-counter-text" class="text-brand-cyan">Página 1</span> <span class="text-slate-600">/</span> <span class="text-slate-400">10</span>
        </div>

        <!-- Keyboard Hint (Desktop Only) -->
        <div class="hidden sm:flex items-center gap-1.5 font-mono text-[11px] text-slate-500">
          <span>Usa teclas</span>
          <kbd class="px-1.5 py-0.5 bg-white/5 border border-white/10 rounded text-slate-300">A - E</kbd>
          <span>o clic</span>
        </div>
      </div>
    </footer>

  </div>

  <!-- Wizard State Machine & Client Script -->
  <script>
    // Wizard Data Store
    const formData: Record<string, any> = {
      tipo_evento: '',
      sector: '',
      aforo: '',
      tiempo: '',
      presupuesto: '',
      servicios: [] as string[],
      descripcion: '',
      nombre: '',
      empresa: '',
      cargo: '',
      email: '',
      telefono: ''
    };

    let currentStep = 1;
    const totalSteps = 10;

    // DOM Elements
    const progressBarFill = document.getElementById('progress-bar-fill') as HTMLElement;
    const pageCounterText = document.getElementById('page-counter-text') as HTMLElement;
    const btnPrev = document.getElementById('btn-step-prev') as HTMLButtonElement;
    const bottomBar = document.getElementById('wizard-bottom-bar') as HTMLElement;

    // Step Sections
    const steps: HTMLElement[] = [];
    for (let i = 1; i <= totalSteps; i++) {
      const el = document.getElementById(`step-${i}`);
      if (el) steps.push(el);
    }
    const stepSuccess = document.getElementById('step-success') as HTMLElement;

    // Check for query parameter (e.g. ?servicio=btl)
    const urlParams = new URLSearchParams(window.location.search);
    const prefillServicio = urlParams.get('servicio');
    if (prefillServicio) {
      if (prefillServicio.toLowerCase().includes('btl')) {
        formData.tipo_evento = 'Activación BTL o Stand Ferial';
      } else if (prefillServicio.toLowerCase().includes('audiovisual')) {
        formData.tipo_evento = 'Producción Audiovisual & Spots';
      } else if (prefillServicio.toLowerCase().includes('gala') || prefillServicio.toLowerCase().includes('fiesta')) {
        formData.tipo_evento = 'Fiesta de Integración / Gala Anual';
      }
    }

    // Function to render a specific step
    function goToStep(stepNum: number) {
      if (stepNum < 1 || stepNum > totalSteps + 1) return;

      // Hide all steps
      steps.forEach((el) => {
        el.classList.add('hidden');
        el.classList.remove('flex');
      });
      if (stepSuccess) {
        stepSuccess.classList.add('hidden');
        stepSuccess.classList.remove('flex');
      }

      currentStep = stepNum;

      if (currentStep <= totalSteps) {
        const activeStep = steps[currentStep - 1];
        if (activeStep) {
          activeStep.classList.remove('hidden');
          activeStep.classList.add('flex');
        }

        // Update progress bar
        const percent = Math.round((currentStep / totalSteps) * 100);
        if (progressBarFill) {
          progressBarFill.style.width = `${percent}%`;
        }

        // Update page counter
        if (pageCounterText) {
          pageCounterText.textContent = `Página ${currentStep}`;
        }

        // Handle prev button visibility
        if (btnPrev) {
          if (currentStep === 1) {
            btnPrev.classList.add('opacity-0', 'pointer-events-none');
          } else {
            btnPrev.classList.remove('opacity-0', 'pointer-events-none');
          }
        }

        // Focus first input if any
        setTimeout(() => {
          const input = activeStep?.querySelector('input, textarea') as HTMLElement;
          if (input && window.innerWidth > 768) {
            input.focus();
          }
        }, 150);

      } else {
        // Step Success
        if (stepSuccess) {
          stepSuccess.classList.remove('hidden');
          stepSuccess.classList.add('flex');
        }
        if (progressBarFill) {
          progressBarFill.style.width = '100%';
        }
        if (bottomBar) {
          bottomBar.classList.add('hidden');
        }

        // Populate recap
        const recapNombreEmpresa = document.getElementById('recap-nombre-empresa');
        const recapTipo = document.getElementById('recap-tipo');
        const recapAforo = document.getElementById('recap-aforo');
        const recapPresupuesto = document.getElementById('recap-presupuesto');

        if (recapNombreEmpresa) {
          recapNombreEmpresa.textContent = `${formData.nombre || 'Cliente'} (${formData.empresa || 'Empresa'})`;
        }
        if (recapTipo) {
          recapTipo.textContent = formData.tipo_evento || 'Experiencia Personalizada';
        }
        if (recapAforo) {
          recapAforo.textContent = formData.aforo || 'Por definir';
        }
        if (recapPresupuesto) {
          recapPresupuesto.textContent = formData.presupuesto || 'Por definir';
        }
      }

      // Scroll smoothly to top of wizard container
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Auto-advance click handlers for single-select buttons
    document.querySelectorAll('.wizard-option-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const button = e.currentTarget as HTMLButtonElement;
        const key = button.getAttribute('data-key');
        const val = button.getAttribute('data-value');

        if (key && val) {
          formData[key] = val;

          // Add active styles
          const parent = button.closest('.wizard-step');
          parent?.querySelectorAll('.wizard-option-btn').forEach((b) => {
            b.classList.remove('border-brand-cyan', 'bg-[#162035]', 'shadow-glow-cyan');
          });
          button.classList.add('border-brand-cyan', 'bg-[#162035]', 'shadow-glow-cyan');

          // Snappy auto advance after 220ms
          setTimeout(() => {
            goToStep(currentStep + 1);
          }, 220);
        }
      });
    });

    // Step 6: Continue button for multi-select
    const btnStep6 = document.getElementById('btn-step-6-continue');
    btnStep6?.addEventListener('click', () => {
      const checkedBoxes = document.querySelectorAll<HTMLInputElement>('.service-checkbox:checked');
      formData.servicios = Array.from(checkedBoxes).map(cb => cb.value);
      goToStep(7);
    });

    // Step 7: Continue or Skip description
    const descInput = document.getElementById('input-descripcion') as HTMLTextAreaElement;
    const btnStep7 = document.getElementById('btn-step-7-continue');
    const btnStep7Skip = document.getElementById('btn-step-7-skip');

    btnStep7?.addEventListener('click', () => {
      if (descInput) formData.descripcion = descInput.value.trim();
      goToStep(8);
    });

    btnStep7Skip?.addEventListener('click', () => {
      formData.descripcion = '';
      goToStep(8);
    });

    // Step 8: Nombre y Empresa
    const inputNombre = document.getElementById('input-nombre') as HTMLInputElement;
    const inputEmpresa = document.getElementById('input-empresa') as HTMLInputElement;
    const btnStep8 = document.getElementById('btn-step-8-continue');
    const step8Error = document.getElementById('step-8-error');

    btnStep8?.addEventListener('click', () => {
      const nombre = inputNombre?.value.trim();
      const empresa = inputEmpresa?.value.trim();

      if (!nombre || !empresa) {
        if (step8Error) step8Error.classList.remove('hidden');
        if (!nombre && inputNombre) inputNombre.focus();
        else if (!empresa && inputEmpresa) inputEmpresa.focus();
        return;
      }

      if (step8Error) step8Error.classList.add('hidden');
      formData.nombre = nombre;
      formData.empresa = empresa;
      goToStep(9);
    });

    // Step 10: Email y Teléfono (Final Submit)
    const inputEmail = document.getElementById('input-email') as HTMLInputElement;
    const inputTelefono = document.getElementById('input-telefono') as HTMLInputElement;
    const btnFinalSubmit = document.getElementById('btn-final-submit') as HTMLButtonElement;
    const step10Error = document.getElementById('step-10-error');
    const submitBtnText = document.getElementById('submit-btn-text');
    const submitBtnIcon = document.getElementById('submit-btn-icon');
    const submitBtnSpinner = document.getElementById('submit-btn-spinner');

    btnFinalSubmit?.addEventListener('click', () => {
      const email = inputEmail?.value.trim();
      const telefono = inputTelefono?.value.trim();
      const emailValid = email && /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      const telValid = telefono && telefono.length >= 7;

      if (!emailValid || !telValid) {
        if (step10Error) step10Error.classList.remove('hidden');
        return;
      }

      if (step10Error) step10Error.classList.add('hidden');
      formData.email = email;
      formData.telefono = telefono;

      // Loading state
      btnFinalSubmit.disabled = true;
      if (submitBtnText) submitBtnText.textContent = 'Procesando y Asignando Agente...';
      if (submitBtnIcon) submitBtnIcon.classList.add('hidden');
      if (submitBtnSpinner) submitBtnSpinner.classList.remove('hidden');

      // Save to localStorage for client-side persistence
      try {
        const history = JSON.parse(localStorage.getItem('sonica_cotizaciones') || '[]');
        history.push({ ...formData, timestamp: new Date().toISOString() });
        localStorage.setItem('sonica_cotizaciones', JSON.stringify(history));
      } catch (e) {
        console.warn('LocalStorage not available');
      }

      // Simulate network request / API dispatch
      setTimeout(() => {
        goToStep(11); // Success state
      }, 1000);
    });

    // Previous Button click
    btnPrev?.addEventListener('click', () => {
      if (currentStep > 1) {
        goToStep(currentStep - 1);
      }
    });

    // Keyboard navigation (Enter to advance on inputs, keys A-E on options)
    window.addEventListener('keydown', (e) => {
      if (currentStep > totalSteps) return;

      // Enter key handler
      if (e.key === 'Enter' && !e.shiftKey) {
        if (currentStep === 6) {
          e.preventDefault();
          btnStep6?.click();
        } else if (currentStep === 7) {
          // If in textarea, ctrl+enter or click continue
          if (document.activeElement !== descInput) {
            e.preventDefault();
            btnStep7?.click();
          }
        } else if (currentStep === 8) {
          e.preventDefault();
          btnStep8?.click();
        } else if (currentStep === 10) {
          e.preventDefault();
          btnFinalSubmit?.click();
        }
      }

      // Escape key to go back
      if (e.key === 'Escape' && currentStep > 1) {
        e.preventDefault();
        goToStep(currentStep - 1);
      }

      // Quick key selection (A, B, C, D, E) when not typing in an input
      const isTyping = ['INPUT', 'TEXTAREA'].includes((document.activeElement?.tagName || ''));
      if (!isTyping && ['a', 'b', 'c', 'd', 'e', 'f', 'g'].includes(e.key.toLowerCase())) {
        const activeStep = steps[currentStep - 1];
        if (activeStep) {
          const optionBtns = activeStep.querySelectorAll<HTMLButtonElement>('.wizard-option-btn');
          const indexMap: Record<string, number> = { a: 0, b: 1, c: 2, d: 3, e: 4, f: 5, g: 6 };
          const btnToClick = optionBtns[indexMap[e.key.toLowerCase()]];
          if (btnToClick) {
            e.preventDefault();
            btnToClick.click();
          }
        }
      }
    });

    // Initialize first step
    goToStep(1);
  </script>
</Layout>
