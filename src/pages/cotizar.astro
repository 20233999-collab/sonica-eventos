---
// src/pages/cotizar.astro - Onboarding de Cotización B2B Paso a Paso (Optimizado con micro-interacciones)
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Cotizador Interactivo de Eventos & BTL | SÓNICA PERÚ"
  description="Diseña tu evento corporativo, activación BTL o producción integral en 10 pasos rápidos. Un agente especializado se contactará lo antes posible con tu propuesta."
>
  <div class="min-h-screen bg-canvas text-slate-100 flex flex-col justify-between relative overflow-x-hidden selection:bg-brand-cyan/30 selection:text-white">
    
    <!-- Ambient Background Lighting -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="absolute top-[-15%] left-1/2 -translate-x-1/2 w-[750px] h-[500px] bg-brand-cyan/10 rounded-full blur-[180px] mix-blend-screen"></div>
      <div class="absolute bottom-[-10%] right-[-5%] w-[650px] h-[650px] bg-brand-blue/10 rounded-full blur-[180px] mix-blend-screen"></div>
    </div>

    <!-- UNIVERSAL HEADER: Centered Logo + Exit Link + Phase Indicator -->
    <header class="w-full relative z-20 border-b border-white/5 bg-canvas/90 backdrop-blur-xl">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-3.5 sm:py-4 flex items-center justify-between">
        
        <!-- Back to site link (Left) -->
        <a
          href="/"
          class="text-xs font-mono text-slate-400 hover:text-white flex items-center gap-1.5 transition-all group py-1.5 px-2.5 rounded-lg hover:bg-white/5"
          title="Volver a la web principal"
        >
          <svg class="w-3.5 h-3.5 transform group-hover:-translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m15 18-6-6 6-6" />
          </svg>
          <span class="hidden sm:inline">Volver a inicio</span>
          <span class="sm:hidden">Salir</span>
        </a>

        <!-- CENTERED LOGO: SÓNICA PERÚ (Universal Center Position) -->
        <a href="/" class="flex items-center gap-2.5 group mx-auto pr-6 sm:pr-0">
          <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-gradient-to-tr from-brand-cyan to-brand-blue flex items-center justify-center shadow-glow-cyan shrink-0 group-hover:scale-105 transition-transform duration-300">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 10v3" />
              <path d="M6 6v11" />
              <path d="M10 3v18" />
              <path d="M14 8v7" />
              <path d="M18 5v13" />
              <path d="M22 10v4" />
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="font-display font-extrabold tracking-tight text-base sm:text-lg text-white leading-none">
              SÓNICA<span class="text-brand-cyan">.</span>
            </span>
            <span class="font-mono text-[9px] sm:text-[10px] tracking-widest text-slate-400 uppercase -mt-0.5">PERÚ</span>
          </div>
        </a>

        <!-- Exit Cross (Right) -->
        <a
          href="/"
          class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-white/5 transition-colors"
          title="Cerrar cotizador"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </a>
      </div>

      <!-- UNIVERSAL PROGRESS BAR: Directly Under the Logo with Glow Accent -->
      <div class="w-full bg-white/5 h-1.5 relative overflow-hidden">
        <div
          id="progress-bar-fill"
          class="h-full bg-gradient-to-r from-brand-cyan via-brand-light to-brand-cyan shadow-glow-cyan transition-all duration-300 ease-out"
          style="width: 10%;"
        ></div>
      </div>

      <!-- Phase Breadcrumb Pill -->
      <div class="max-w-4xl mx-auto px-4 py-1.5 flex items-center justify-between text-[11px] font-mono text-slate-400 border-t border-white/[0.03]">
        <div class="flex items-center gap-1.5">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand-cyan animate-pulse"></span>
          <span id="header-phase-text" class="text-slate-300 font-medium">Fase 1 • Requerimiento Principal</span>
        </div>
        <div id="header-percent-text" class="text-brand-cyan font-semibold">10% Completado</div>
      </div>
    </header>

    <!-- MAIN INTERACTIVE WIZARD CONTAINER -->
    <main class="relative z-10 flex-1 flex flex-col justify-center items-center px-4 sm:px-6 py-6 sm:py-10 max-w-3xl mx-auto w-full min-h-[560px]">

      <!-- ========================================== -->
      <!-- PÁGINA 1: Tipo de Experiencia o Servicio -->
      <!-- ========================================== -->
      <section id="step-1" class="wizard-step w-full flex flex-col items-center" data-step="1" data-phase="Fase 1 • Requerimiento Principal">
        <div class="text-center mb-6 sm:mb-8 max-w-xl">
          <span class="inline-block font-mono text-xs uppercase tracking-widest text-brand-cyan font-semibold mb-2">
            Paso 01 / 10
          </span>
          <h1 class="font-display font-black text-2xl sm:text-4xl text-white tracking-tight uppercase leading-tight mb-2">
            ¿Qué tipo de experiencia deseas crear?
          </h1>
          <p class="font-body text-slate-400 text-sm sm:text-base leading-relaxed">
            Selecciona la opción principal. Avanza automáticamente con un solo toque.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-3.5 w-full max-w-2xl">
          <!-- Option A: Convención -->
          <button
            type="button"
            class="wizard-option-btn group relative flex items-start gap-3.5 p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all duration-150 shadow-beautiful-sm hover:shadow-glow-cyan cursor-pointer"
            data-key="tipo_evento"
            data-value="Convención o Congreso Corporativo"
          >
            <div class="w-10 h-10 rounded-xl bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center shrink-0 text-brand-cyan group-hover:scale-105 group-hover:bg-brand-cyan group-hover:text-white transition-all">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="20" height="14" x="2" y="3" rx="2" /><line x1="8" x2="16" y1="21" y2="21" /><line x1="12" x2="12" y1="17" y2="21" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <h3 class="font-display font-bold text-base text-white group-hover:text-brand-light transition-colors">
                  Convención o Congreso
                </h3>
                <span class="font-mono text-[10px] text-slate-400 border border-white/10 px-1.5 py-0.5 rounded">A</span>
              </div>
              <p class="font-body text-xs text-slate-400 leading-snug mt-1">
                Lanzamientos anuales, plenarias y jornadas ejecutivas.
              </p>
            </div>
          </button>

          <!-- Option B: Gala / Fiesta -->
          <button
            type="button"
            class="wizard-option-btn group relative flex items-start gap-3.5 p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all duration-150 shadow-beautiful-sm hover:shadow-glow-cyan cursor-pointer"
            data-key="tipo_evento"
            data-value="Fiesta de Integración / Gala Anual"
          >
            <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center shrink-0 text-purple-400 group-hover:scale-105 group-hover:bg-purple-500 group-hover:text-white transition-all">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <h3 class="font-display font-bold text-base text-white group-hover:text-purple-300 transition-colors">
                  Fiesta de Gala / Aniversario
                </h3>
                <span class="font-mono text-[10px] text-slate-400 border border-white/10 px-1.5 py-0.5 rounded">B</span>
              </div>
              <p class="font-body text-xs text-slate-400 leading-snug mt-1">
                Celebraciones de fin de año, premiaciones y cenas VIP.
              </p>
            </div>
          </button>

          <!-- Option C: BTL / Stand -->
          <button
            type="button"
            class="wizard-option-btn group relative flex items-start gap-3.5 p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all duration-150 shadow-beautiful-sm hover:shadow-glow-cyan cursor-pointer"
            data-key="tipo_evento"
            data-value="Activación BTL o Stand Ferial"
          >
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center shrink-0 text-amber-400 group-hover:scale-105 group-hover:bg-amber-500 group-hover:text-white transition-all">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m3 11 18-5v12L3 14v-3z" /><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <h3 class="font-display font-bold text-base text-white group-hover:text-amber-300 transition-colors">
                  Activación BTL / Stand
                </h3>
                <span class="font-mono text-[10px] text-slate-400 border border-white/10 px-1.5 py-0.5 rounded">C</span>
              </div>
              <p class="font-body text-xs text-slate-400 leading-snug mt-1">
                Puntos de venta, ferias comerciales y anfitrionaje.
              </p>
            </div>
          </button>

          <!-- Option D: Audiovisual -->
          <button
            type="button"
            class="wizard-option-btn group relative flex items-start gap-3.5 p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all duration-150 shadow-beautiful-sm hover:shadow-glow-cyan cursor-pointer"
            data-key="tipo_evento"
            data-value="Producción Audiovisual & Spots"
          >
            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center shrink-0 text-emerald-400 group-hover:scale-105 group-hover:bg-emerald-500 group-hover:text-white transition-all">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m22 8-6 4 6 4V8Z" /><rect width="14" height="12" x="2" y="6" rx="2" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <h3 class="font-display font-bold text-base text-white group-hover:text-emerald-300 transition-colors">
                  Producción Audiovisual
                </h3>
                <span class="font-mono text-[10px] text-slate-400 border border-white/10 px-1.5 py-0.5 rounded">D</span>
              </div>
              <p class="font-body text-xs text-slate-400 leading-snug mt-1">
                Multicámara, reels verticales, spots y drones.
              </p>
            </div>
          </button>

          <!-- Option E: Campaña 360° -->
          <button
            type="button"
            class="wizard-option-btn sm:col-span-2 group relative flex items-start gap-3.5 p-4.5 rounded-2xl bg-gradient-to-r from-[#0E1626] to-[#162035] hover:from-[#162035] hover:to-[#1c2944] active:scale-[0.98] border border-brand-cyan/40 hover:border-brand-cyan text-left transition-all duration-150 shadow-beautiful-md hover:shadow-glow-cyan cursor-pointer"
            data-key="tipo_evento"
            data-value="Campaña Integral 360°"
          >
            <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-brand-cyan to-brand-blue flex items-center justify-center shrink-0 text-white shadow-glow-cyan group-hover:scale-105 transition-all">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <h3 class="font-display font-black text-base sm:text-lg text-white group-hover:text-brand-light transition-colors">
                    Campaña Integral 360° All-In-One
                  </h3>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-mono font-bold bg-brand-cyan/20 text-brand-cyan border border-brand-cyan/40">
                    TOP 1
                  </span>
                </div>
                <span class="font-mono text-[10px] text-brand-cyan border border-brand-cyan/30 px-1.5 py-0.5 rounded">E</span>
              </div>
              <p class="font-body text-xs text-slate-300 leading-snug mt-1">
                Escenografía LED + Audio y luces + Merch corporativo + Reels y BTL sin intermediarios.
              </p>
            </div>
          </button>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- PÁGINA 2: Sector o Industria de la Empresa -->
      <!-- ========================================== -->
      <section id="step-2" class="wizard-step w-full flex-col items-center hidden" data-step="2" data-phase="Fase 1 • Contexto Corporativo">
        <div class="text-center mb-6 sm:mb-8 max-w-xl">
          <span class="inline-block font-mono text-xs uppercase tracking-widest text-brand-cyan font-semibold mb-2">
            Paso 02 / 10
          </span>
          <h2 class="font-display font-black text-2xl sm:text-4xl text-white tracking-tight uppercase leading-tight mb-2">
            ¿A qué sector pertenece tu empresa?
          </h2>
          <p class="font-body text-slate-400 text-sm sm:text-base leading-relaxed">
            Adaptamos la normativa técnica, permisos y estética según tu rubro.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full max-w-2xl">
          <button type="button" class="wizard-option-btn group flex items-center justify-between p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all" data-key="sector" data-value="Farmacéutica, Salud & Belleza">
            <div class="flex items-center gap-3">
              <span class="text-lg">💊</span>
              <span class="font-body font-medium text-sm text-slate-200 group-hover:text-white">Farmacéutica & Salud</span>
            </div>
            <span class="font-mono text-[10px] text-slate-400 border border-white/10 px-1.5 py-0.5 rounded">A</span>
          </button>

          <button type="button" class="wizard-option-btn group flex items-center justify-between p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all" data-key="sector" data-value="Banca, Finanzas, Seguros & Fintech">
            <div class="flex items-center gap-3">
              <span class="text-lg">💳</span>
              <span class="font-body font-medium text-sm text-slate-200 group-hover:text-white">Banca, Seguros & Fintech</span>
            </div>
            <span class="font-mono text-[10px] text-slate-400 border border-white/10 px-1.5 py-0.5 rounded">B</span>
          </button>

          <button type="button" class="wizard-option-btn group flex items-center justify-between p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all" data-key="sector" data-value="Consumo Masivo, Retail & Bebidas">
            <div class="flex items-center gap-3">
              <span class="text-lg">🛍️</span>
              <span class="font-body font-medium text-sm text-slate-200 group-hover:text-white">Consumo Masivo & Retail</span>
            </div>
            <span class="font-mono text-[10px] text-slate-400 border border-white/10 px-1.5 py-0.5 rounded">C</span>
          </button>

          <button type="button" class="wizard-option-btn group flex items-center justify-between p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all" data-key="sector" data-value="Inmobiliaria, Construcción & Arquitectura">
            <div class="flex items-center gap-3">
              <span class="text-lg">🏗️</span>
              <span class="font-body font-medium text-sm text-slate-200 group-hover:text-white">Inmobiliaria & Construcción</span>
            </div>
            <span class="font-mono text-[10px] text-slate-400 border border-white/10 px-1.5 py-0.5 rounded">D</span>
          </button>

          <button type="button" class="wizard-option-btn group flex items-center justify-between p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all" data-key="sector" data-value="Minería, Energía, Industria & Logística">
            <div class="flex items-center gap-3">
              <span class="text-lg">⚡</span>
              <span class="font-body font-medium text-sm text-slate-200 group-hover:text-white">Minería, Energía & Logística</span>
            </div>
            <span class="font-mono text-[10px] text-slate-400 border border-white/10 px-1.5 py-0.5 rounded">E</span>
          </button>

          <button type="button" class="wizard-option-btn group flex items-center justify-between p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all" data-key="sector" data-value="Tecnología, Telecomunicaciones & Medios">
            <div class="flex items-center gap-3">
              <span class="text-lg">💻</span>
              <span class="font-body font-medium text-sm text-slate-200 group-hover:text-white">Tecnología & Telecom</span>
            </div>
            <span class="font-mono text-[10px] text-slate-400 border border-white/10 px-1.5 py-0.5 rounded">F</span>
          </button>

          <button type="button" class="wizard-option-btn sm:col-span-2 group flex items-center justify-between p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all" data-key="sector" data-value="Otro Sector Empresarial">
            <div class="flex items-center gap-3">
              <span class="text-lg">🏢</span>
              <span class="font-body font-medium text-sm text-slate-200 group-hover:text-white">Otro sector empresarial / Servicios corporativos</span>
            </div>
            <span class="font-mono text-[10px] text-slate-400 border border-white/10 px-1.5 py-0.5 rounded">G</span>
          </button>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- PÁGINA 3: Aforo o Cantidad de Asistentes -->
      <!-- ========================================== -->
      <section id="step-3" class="wizard-step w-full flex-col items-center hidden" data-step="3" data-phase="Fase 2 • Alcance & Escala">
        <div class="text-center mb-6 sm:mb-8 max-w-xl">
          <span class="inline-block font-mono text-xs uppercase tracking-widest text-brand-cyan font-semibold mb-2">
            Paso 03 / 10
          </span>
          <h2 class="font-display font-black text-2xl sm:text-4xl text-white tracking-tight uppercase leading-tight mb-2">
            ¿Cuántas personas asistirán?
          </h2>
          <p class="font-body text-slate-400 text-sm sm:text-base leading-relaxed">
            Calcularemos dimensiones de pantallas LED, potencia de sonido y acreditación.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 w-full max-w-2xl">
          <button type="button" class="wizard-option-btn group p-4 rounded-2xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all" data-key="aforo" data-value="Formato VIP (Hasta 80 pers.)">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xl">👑</span>
              <span class="font-mono text-[10px] text-slate-400 border border-white/10 px-1.5 py-0.5 rounded">A</span>
            </div>
            <h4 class="font-display font-bold text-base text-white group-hover:text-brand-light">Hasta 80 invitados</h4>
            <p class="font-body text-xs text-slate-400 mt-0.5">Lanzamientos VIP, directorios y cenas selectas.</p>
          </button>

          <button type="button" class="wizard-option-btn group p-4 rounded-2xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all" data-key="aforo" data-value="Formato Mediano (80 a 300 pers.)">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xl">👥</span>
              <span class="font-mono text-[10px] text-slate-400 border border-white/10 px-1.5 py-0.5 rounded">B</span>
            </div>
            <h4 class="font-display font-bold text-base text-white group-hover:text-brand-light">80 a 300 personas</h4>
            <p class="font-body text-xs text-slate-400 mt-0.5">Integraciones, talleres y aniversarios de mediana escala.</p>
          </button>

          <button type="button" class="wizard-option-btn group p-4 rounded-2xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all" data-key="aforo" data-value="Gran Escala Corporativa (300 a 1,000 pers.)">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xl">🏛️</span>
              <span class="font-mono text-[10px] text-slate-400 border border-white/10 px-1.5 py-0.5 rounded">C</span>
            </div>
            <h4 class="font-display font-bold text-base text-white group-hover:text-brand-light">300 a 1,000 asistentes</h4>
            <p class="font-body text-xs text-slate-400 mt-0.5">Grandes convenciones, fiestas corporativas y congresos.</p>
          </button>

          <button type="button" class="wizard-option-btn group p-4 rounded-2xl bg-[#0E1626]/90 hover:bg-[#162035] active:scale-[0.98] border border-white/10 hover:border-brand-cyan text-left transition-all" data-key="aforo" data-value="Aforo Masivo (+1,000 personas)">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xl">🏟️</span>
