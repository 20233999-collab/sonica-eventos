---
// src/pages/cotizar.astro - Onboarding de Cotización B2B Paso a Paso
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Cotizador Interactivo de Eventos & BTL | SÓNICA PERÚ"
  description="Diseña tu evento corporativo, activación BTL o producción audiovisual a medida en 10 pasos rápidos. Un agente de cuentas se contactará lo antes posible con tu propuesta."
>
  <div class="min-h-screen bg-canvas text-slate-100 flex flex-col justify-between relative overflow-x-hidden selection:bg-brand-cyan/30 selection:text-white">
    
    <!-- Ambient Background Lighting -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <div class="absolute top-[-10%] left-1/2 -translate-x-1/2 w-[700px] h-[500px] bg-brand-cyan/10 rounded-full blur-[160px] mix-blend-screen"></div>
      <div class="absolute bottom-[-10%] right-[-5%] w-[600px] h-[600px] bg-brand-blue/10 rounded-full blur-[180px] mix-blend-screen"></div>
    </div>

    <!-- UNIVERSAL HEADER: Centered Logo + Exit Link -->
    <header class="w-full relative z-20 border-b border-white/5 bg-canvas/80 backdrop-blur-md">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
        <!-- Back to site button (Desktop spacer / exit) -->
        <a
          href="/"
          class="text-xs font-mono text-slate-400 hover:text-white flex items-center gap-1.5 transition-colors group py-1 px-2 rounded-lg hover:bg-white/5"
          title="Volver a la página principal"
        >
          <svg class="w-3.5 h-3.5 transform group-hover:-translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m15 18-6-6 6-6" />
          </svg>
          <span class="hidden sm:inline">Volver a inicio</span>
          <span class="sm:hidden">Inicio</span>
        </a>

        <!-- CENTERED LOGO: SÓNICA PERÚ -->
        <a href="/" class="flex items-center gap-2.5 group mx-auto pr-6 sm:pr-0">
          <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-gradient-to-tr from-brand-cyan to-brand-blue flex items-center justify-center shadow-glow-cyan shrink-0 group-hover:scale-105 transition-transform duration-300">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 10v3" />
              <path d="M6 6v11" />
              <path d="M10 3v18" />
              <path d="M14 8v7" />
              <path d="M18 5v13" />
              <path d="M22 10v4" />
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="font-display font-extrabold tracking-tight text-base sm:text-lg text-white leading-none">
              SÓNICA<span class="text-brand-cyan">.</span>
            </span>
            <span class="font-mono text-[9px] sm:text-[10px] tracking-widest text-slate-400 uppercase -mt-0.5">PERÚ</span>
          </div>
        </a>

        <!-- Exit Cross -->
        <a
          href="/"
          class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-white/5 transition-colors"
          title="Cerrar cotizador"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </a>
      </div>

      <!-- UNIVERSAL PROGRESS BAR: Directly Under the Logo -->
      <div class="w-full bg-white/5 h-1 relative overflow-hidden">
        <div
          id="progress-bar-fill"
          class="h-full bg-gradient-to-r from-brand-cyan via-brand-light to-brand-cyan shadow-glow-cyan transition-all duration-500 ease-out"
          style="width: 10%;"
        ></div>
      </div>
    </header>

    <!-- MAIN INTERACTIVE WIZARD CONTAINER -->
    <main class="relative z-10 flex-1 flex flex-col justify-center items-center px-4 sm:px-6 py-6 sm:py-10 max-w-3xl mx-auto w-full">

      <!-- ========================================== -->
      <!-- PÁGINA 1: Tipo de Experiencia o Servicio -->
      <!-- ========================================== -->
      <section id="step-1" class="wizard-step w-full flex flex-col items-center animate-fade-in" data-step="1">
        <!-- Question Header -->
        <div class="text-center mb-6 sm:mb-8 max-w-xl">
          <span class="inline-block font-mono text-xs uppercase tracking-widest text-brand-cyan font-semibold mb-2">
            Paso 01 • Requerimiento Principal
          </span>
          <h1 class="font-display font-black text-2xl sm:text-4xl text-white tracking-tight uppercase leading-tight mb-2">
            ¿Qué tipo de experiencia deseas crear?
          </h1>
          <p class="font-body text-slate-400 text-sm sm:text-base leading-relaxed">
            Selecciona la categoría que mejor define la necesidad de tu empresa.
          </p>
        </div>

        <!-- Options Grid (Single Select - Auto Advance) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-3.5 w-full max-w-2xl">
          <!-- Option A -->
          <button
            type="button"
            class="wizard-option-btn group relative flex items-start gap-3.5 p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all duration-200 shadow-beautiful-sm hover:shadow-glow-cyan"
            data-key="tipo_evento"
            data-value="Convención o Congreso Corporativo"
          >
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 group-hover:border-brand-cyan/40 px-2 py-1 rounded-lg shrink-0 mt-0.5 transition-colors">
              A
            </span>
            <div class="flex-1 min-w-0">
              <h3 class="font-display font-bold text-base sm:text-lg text-white group-hover:text-brand-light transition-colors">
                Convención o Congreso
              </h3>
              <p class="font-body text-xs sm:text-sm text-slate-400 leading-snug mt-0.5">
                Plenarias, lanzamientos anuales, jornadas ejecutivas y ferias internas.
              </p>
            </div>
          </button>

          <!-- Option B -->
          <button
            type="button"
            class="wizard-option-btn group relative flex items-start gap-3.5 p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all duration-200 shadow-beautiful-sm hover:shadow-glow-cyan"
            data-key="tipo_evento"
            data-value="Fiesta de Integración / Gala Anual"
          >
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 group-hover:border-brand-cyan/40 px-2 py-1 rounded-lg shrink-0 mt-0.5 transition-colors">
              B
            </span>
            <div class="flex-1 min-w-0">
              <h3 class="font-display font-bold text-base sm:text-lg text-white group-hover:text-brand-light transition-colors">
                Fiesta de Integración / Gala
              </h3>
              <p class="font-body text-xs sm:text-sm text-slate-400 leading-snug mt-0.5">
                Fiestas de fin de año, aniversarios, premiaciones VIP y cenas temáticas.
              </p>
            </div>
          </button>

          <!-- Option C -->
          <button
            type="button"
            class="wizard-option-btn group relative flex items-start gap-3.5 p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all duration-200 shadow-beautiful-sm hover:shadow-glow-cyan"
            data-key="tipo_evento"
            data-value="Activación BTL o Stand Ferial"
          >
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 group-hover:border-brand-cyan/40 px-2 py-1 rounded-lg shrink-0 mt-0.5 transition-colors">
              C
            </span>
            <div class="flex-1 min-w-0">
              <h3 class="font-display font-bold text-base sm:text-lg text-white group-hover:text-brand-light transition-colors">
                Activación BTL / Stand
              </h3>
              <p class="font-body text-xs sm:text-sm text-slate-400 leading-snug mt-0.5">
                Puntos de venta, ferias comerciales, dinámicas interactivas y anfitrionaje.
              </p>
            </div>
          </button>

          <!-- Option D -->
          <button
            type="button"
            class="wizard-option-btn group relative flex items-start gap-3.5 p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all duration-200 shadow-beautiful-sm hover:shadow-glow-cyan"
            data-key="tipo_evento"
            data-value="Producción Audiovisual & Spots"
          >
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 group-hover:border-brand-cyan/40 px-2 py-1 rounded-lg shrink-0 mt-0.5 transition-colors">
              D
            </span>
            <div class="flex-1 min-w-0">
              <h3 class="font-display font-bold text-base sm:text-lg text-white group-hover:text-brand-light transition-colors">
                Producción Audiovisual
              </h3>
              <p class="font-body text-xs sm:text-sm text-slate-400 leading-snug mt-0.5">
                Cobertura con multicámara, reels verticales, spots comerciales y streaming.
              </p>
            </div>
          </button>

          <!-- Option E (Spans 2 cols on desktop) -->
          <button
            type="button"
            class="wizard-option-btn sm:col-span-2 group relative flex items-start gap-3.5 p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all duration-200 shadow-beautiful-sm hover:shadow-glow-cyan"
            data-key="tipo_evento"
            data-value="Campaña Integral 360°"
          >
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 group-hover:border-brand-cyan/40 px-2 py-1 rounded-lg shrink-0 mt-0.5 transition-colors">
              E
            </span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <h3 class="font-display font-bold text-base sm:text-lg text-white group-hover:text-brand-light transition-colors">
                  Campaña Integral 360° All-In-One
                </h3>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-brand-cyan/20 text-brand-cyan border border-brand-cyan/30">
                  RECOMENDADO
                </span>
              </div>
              <p class="font-body text-xs sm:text-sm text-slate-400 leading-snug mt-0.5">
                Escenografía de gran formato + Audio y luces + Merch premium + Video y BTL sin intermediarios.
              </p>
            </div>
          </button>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- PÁGINA 2: Sector o Industria de la Empresa -->
      <!-- ========================================== -->
      <section id="step-2" class="wizard-step w-full flex-col items-center hidden" data-step="2">
        <div class="text-center mb-6 sm:mb-8 max-w-xl">
          <span class="inline-block font-mono text-xs uppercase tracking-widest text-brand-cyan font-semibold mb-2">
            Paso 02 • Contexto Corporativo
          </span>
          <h2 class="font-display font-black text-2xl sm:text-4xl text-white tracking-tight uppercase leading-tight mb-2">
            ¿A qué sector pertenece tu empresa?
          </h2>
          <p class="font-body text-slate-400 text-sm sm:text-base leading-relaxed">
            Nos permite adaptar los protocolos, estilo visual y estándares de la propuesta.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full max-w-2xl">
          <button type="button" class="wizard-option-btn group flex items-center gap-3 p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all" data-key="sector" data-value="Farmacéutica, Salud & Belleza">
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">A</span>
            <span class="font-body font-medium text-sm sm:text-base text-slate-200 group-hover:text-white">Farmacéutica, Salud & Belleza</span>
          </button>

          <button type="button" class="wizard-option-btn group flex items-center gap-3 p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all" data-key="sector" data-value="Banca, Finanzas, Seguros & Fintech">
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">B</span>
            <span class="font-body font-medium text-sm sm:text-base text-slate-200 group-hover:text-white">Banca, Seguros & Fintech</span>
          </button>

          <button type="button" class="wizard-option-btn group flex items-center gap-3 p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all" data-key="sector" data-value="Consumo Masivo, Retail & Bebidas">
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">C</span>
            <span class="font-body font-medium text-sm sm:text-base text-slate-200 group-hover:text-white">Consumo Masivo, Retail & Bebidas</span>
          </button>

          <button type="button" class="wizard-option-btn group flex items-center gap-3 p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all" data-key="sector" data-value="Inmobiliaria, Construcción & Arquitectura">
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">D</span>
            <span class="font-body font-medium text-sm sm:text-base text-slate-200 group-hover:text-white">Inmobiliaria & Construcción</span>
          </button>

          <button type="button" class="wizard-option-btn group flex items-center gap-3 p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all" data-key="sector" data-value="Minería, Energía, Industria & Logística">
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">E</span>
            <span class="font-body font-medium text-sm sm:text-base text-slate-200 group-hover:text-white">Minería, Energía & Logística</span>
          </button>

          <button type="button" class="wizard-option-btn group flex items-center gap-3 p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all" data-key="sector" data-value="Tecnología, Telecomunicaciones & Medios">
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">F</span>
            <span class="font-body font-medium text-sm sm:text-base text-slate-200 group-hover:text-white">Tecnología & Telecomunicaciones</span>
          </button>

          <button type="button" class="wizard-option-btn sm:col-span-2 group flex items-center gap-3 p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all" data-key="sector" data-value="Otro Sector Empresarial">
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">G</span>
            <span class="font-body font-medium text-sm sm:text-base text-slate-200 group-hover:text-white">Otro sector empresarial / Servicios generales</span>
          </button>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- PÁGINA 3: Aforo o Cantidad de Asistentes -->
      <!-- ========================================== -->
      <section id="step-3" class="wizard-step w-full flex-col items-center hidden" data-step="3">
        <div class="text-center mb-6 sm:mb-8 max-w-xl">
          <span class="inline-block font-mono text-xs uppercase tracking-widest text-brand-cyan font-semibold mb-2">
            Paso 03 • Escala de Asistentes
          </span>
          <h2 class="font-display font-black text-2xl sm:text-4xl text-white tracking-tight uppercase leading-tight mb-2">
            ¿Cuántas personas asistirán al evento?
          </h2>
          <p class="font-body text-slate-400 text-sm sm:text-base leading-relaxed">
            Calcularemos los requerimientos de audio, pantallas LED y acreditación.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 w-full max-w-2xl">
          <button type="button" class="wizard-option-btn group p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all" data-key="aforo" data-value="Formato VIP / Íntimo (Hasta 80 pers.)">
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">A</span>
            <h4 class="font-display font-bold text-base text-white mt-2 group-hover:text-brand-light">Hasta 80 invitados</h4>
            <p class="font-body text-xs text-slate-400">Reuniones directivas, lanzamientos VIP y cenas exclusivas.</p>
          </button>

          <button type="button" class="wizard-option-btn group p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all" data-key="aforo" data-value="Formato Mediano (80 a 300 pers.)">
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">B</span>
            <h4 class="font-display font-bold text-base text-white mt-2 group-hover:text-brand-light">80 a 300 invitados</h4>
            <p class="font-body text-xs text-slate-400">Jornadas de integración, capacitaciones y aniversarios medianos.</p>
          </button>

          <button type="button" class="wizard-option-btn group p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all" data-key="aforo" data-value="Gran Escala Corporativa (300 a 1,000 pers.)">
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">C</span>
            <h4 class="font-display font-bold text-base text-white mt-2 group-hover:text-brand-light">300 a 1,000 asistentes</h4>
            <p class="font-body text-xs text-slate-400">Convenciones anuales, fiestas de fin de año y congresos.</p>
          </button>

          <button type="button" class="wizard-option-btn group p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all" data-key="aforo" data-value="Aforo Masivo (+1,000 personas)">
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">D</span>
            <h4 class="font-display font-bold text-base text-white mt-2 group-hover:text-brand-light">Más de 1,000 personas</h4>
            <p class="font-body text-xs text-slate-400">Estadios, explanadas, maratones y festivales multitudinarios.</p>
          </button>

          <button type="button" class="wizard-option-btn sm:col-span-2 group p-3.5 sm:p-4 rounded-xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all flex items-center justify-between" data-key="aforo" data-value="Por definir / Requiere asesoría">
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">E</span>
              <span class="font-body font-medium text-sm text-slate-200 group-hover:text-white">Aún por definir (necesitamos asesoría de capacidad)</span>
            </div>
            <span class="font-mono text-xs text-brand-cyan">➔</span>
          </button>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- PÁGINA 4: Nivel de Urgencia / Fecha Tentativa -->
      <!-- ========================================== -->
      <section id="step-4" class="wizard-step w-full flex-col items-center hidden" data-step="4">
        <div class="text-center mb-6 sm:mb-8 max-w-xl">
          <span class="inline-block font-mono text-xs uppercase tracking-widest text-brand-cyan font-semibold mb-2">
            Paso 04 • Cronograma & Tiempos
          </span>
          <h2 class="font-display font-black text-2xl sm:text-4xl text-white tracking-tight uppercase leading-tight mb-2">
            ¿Para cuándo está planificado el evento?
          </h2>
          <p class="font-body text-slate-400 text-sm sm:text-base leading-relaxed">
            Evaluaremos disponibilidad técnica inmediata o plazos de diseño escenográfico.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 w-full max-w-2xl">
          <button type="button" class="wizard-option-btn group p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all" data-key="tiempo" data-value="Inmediato (Menos de 30 días)">
            <div class="flex items-center justify-between mb-2">
              <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">A</span>
              <span class="inline-block w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
            </div>
            <h4 class="font-display font-bold text-base text-white group-hover:text-brand-light">Menos de 30 días (Urgente)</h4>
            <p class="font-body text-xs text-slate-400 mt-1">Puesta en marcha express con equipamiento in-house listo.</p>
          </button>

          <button type="button" class="wizard-option-btn group p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all" data-key="tiempo" data-value="Próximos 1 a 3 meses">
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">B</span>
            <h4 class="font-display font-bold text-base text-white mt-2 group-hover:text-brand-light">Próximos 1 a 3 meses</h4>
            <p class="font-body text-xs text-slate-400 mt-1">Plazo óptimo para renderizado 3D, branding y montaje integral.</p>
          </button>

          <button type="button" class="wizard-option-btn group p-4 sm:p-4.5 rounded-2xl bg-[#0E1626]/80 hover:bg-[#162035] border border-white/10 hover:border-brand-cyan/60 text-left transition-all" data-key="tiempo" data-value="En más de 3 meses">
            <span class="font-mono text-xs font-bold text-slate-400 group-hover:text-brand-cyan border border-white/10 px-2 py-0.5 rounded">C</span>
